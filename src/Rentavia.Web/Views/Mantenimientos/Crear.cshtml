@model MantenimientoForm
@{ ViewData["Title"] = "Programar mantenimiento"; }
<div class="page-heading">
<div>
<h1>Programar mantenimiento</h1>
<p class="lead-text">Completa los datos y revisa antes de confirmar.</p>
</div>
</div>
<div class="hint">El mantenimiento bloquea la disponibilidad. Si existe una reserva en el período, debe resolverse primero.</div>
<div class="panel form-panel">
<form asp-action="Crear" method="post" >
<div asp-validation-summary="All">
</div>

<div class="form-grid">
<div class="field">
<label asp-for="VehiculoId">
</label>
<select asp-for="VehiculoId" class="form-select" asp-items="ViewBag.Vehiculos">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="VehiculoId" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Tipo">
</label>
<select asp-for="Tipo" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new[]{"Preventivo","Correctivo"}))">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="Tipo" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Inicio">
</label>
<input asp-for="Inicio" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
<span asp-validation-for="Inicio" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Fin">
</label>
<input asp-for="Fin" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
<span asp-validation-for="Fin" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Costo">
</label>
<input asp-for="Costo" class="form-control" type="number" step="0.01" />
<span asp-validation-for="Costo" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Descripcion">
</label>
<textarea asp-for="Descripcion" class="form-control" rows="3">
</textarea>
<span asp-validation-for="Descripcion" class="text-danger">
</span>
</div>
</div>
<div class="form-actions">
<button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>Programar</button>
<a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Volver</a>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
