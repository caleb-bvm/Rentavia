@model DisponibilidadForm
@{ ViewData["Title"] = "Disponibilidad"; }
<div class="page-heading">
<div>
<span class="eyebrow">BÚSQUEDA POR FECHAS</span>
<h1>Disponibilidad de flota</h1>
<p class="lead-text">Encuentra vehículos para las fechas del viaje.</p>
</div>
</div>
<div class="panel filter-panel">
<form asp-action="Index" method="get" data-rango-fechas>
<div class="filter-header">
<span class="icon" aria-hidden="true">event_available</span>
<div>
<h2>Buscar vehículos</h2>
<p>Indica las fechas del viaje y lo que necesitas; los demás filtros son opcionales.</p>
</div>
</div>
<div class="filter-body">
<div asp-validation-summary="ModelOnly"></div>
<div class="filter-groups">
<fieldset class="filter-group">
<legend><span class="icon" aria-hidden="true">schedule</span>Fechas del viaje</legend>
<div class="field has-icon">
<label asp-for="Inicio">Recogida</label>
<span class="icon field-icon" aria-hidden="true">key</span>
<input asp-for="Inicio" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" data-rango-inicio />
<span asp-validation-for="Inicio" class="text-danger"></span>
</div>
<div class="field has-icon">
<label asp-for="Fin">Devolución</label>
<span class="icon field-icon" aria-hidden="true">assignment_return</span>
<input asp-for="Fin" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" data-rango-fin />
<span asp-validation-for="Fin" class="text-danger"></span>
</div>
</fieldset>
<fieldset class="filter-group">
<legend><span class="icon" aria-hidden="true">group</span>Capacidad</legend>
<div class="filter-row">
<div class="field has-icon">
<label asp-for="Pasajeros"></label>
<span class="icon field-icon" aria-hidden="true">person</span>
<input asp-for="Pasajeros" class="form-control" type="number" min="1" max="50" inputmode="numeric" />
<span asp-validation-for="Pasajeros" class="text-danger"></span>
</div>
<div class="field has-icon">
<label asp-for="Maletas"></label>
<span class="icon field-icon" aria-hidden="true">luggage</span>
<input asp-for="Maletas" class="form-control" type="number" min="0" max="50" inputmode="numeric" />
<span asp-validation-for="Maletas" class="text-danger"></span>
</div>
</div>
<span class="field-hint">Se muestran vehículos con al menos esta capacidad.</span>
</fieldset>
<fieldset class="filter-group">
<legend><span class="icon" aria-hidden="true">tune</span>Más filtros <small>Opcional</small></legend>
<div class="field has-icon">
<label asp-for="CategoriaId"></label>
<span class="icon field-icon" aria-hidden="true">category</span>
<select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
<option value="">Todas las categorías</option>
</select>
<span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>
<div class="field has-icon">
<label asp-for="SucursalId"></label>
<span class="icon field-icon" aria-hidden="true">store</span>
<select asp-for="SucursalId" class="form-select" asp-items="ViewBag.Sucursales">
<option value="">Todas las sucursales</option>
</select>
<span asp-validation-for="SucursalId" class="text-danger"></span>
</div>
</fieldset>
</div>
</div>
<div class="filter-footer">
<span class="filter-summary" data-duracion aria-live="polite"></span>
<div class="filter-actions">
<a asp-action="Index" class="btn btn-outline-secondary">Restablecer</a>
<button class="btn btn-primary"><span class="icon" aria-hidden="true">search</span>Buscar disponibilidad</button>
</div>
</div>
</form>
</div>
<div class="hint">Horario UTC-6. La disponibilidad se verifica nuevamente al confirmar. Tarifa por períodos de 24 horas redondeados hacia arriba.</div>
<div class="vehicle-grid">@foreach(var v in Model.Vehiculos){<article class="vehicle-card">
<div class="vehicle-image">@if(v.FotoRuta is not null){<img src="@v.FotoRuta" alt="@v.Marca @v.Modelo"/>}else{<span class="icon" aria-hidden="true">directions_car</span>}</div>
<div class="vehicle-card-body">
<span><span class="state">Disponible</span></span>
<h3 class="mt-2" title="@v.Marca @v.Modelo @v.Anio">@v.Marca @v.Modelo <small>@v.Anio</small></h3>
<div class="specs">
<span><span class="icon" aria-hidden="true">person</span>@v.CapacidadPasajeros</span>
<span><span class="icon" aria-hidden="true">luggage</span>@v.CapacidadMaletas</span>
<span><span class="icon" aria-hidden="true">settings</span>@v.Transmision</span>
<span title="@v.Sucursal.Nombre"><span class="icon" aria-hidden="true">store</span>@v.Sucursal.Nombre</span>
</div>
<p class="price">@Presentacion.Dinero(v.TarifaDiaria) <small>/ día</small></p>
<a asp-controller="Reservas" asp-action="Editar" asp-route-vehiculoId="@v.Id" asp-route-inicio="@Model.Inicio.ToString("yyyy-MM-ddTHH:mm")" asp-route-fin="@Model.Fin.ToString("yyyy-MM-ddTHH:mm")" class="btn btn-primary"><span class="icon" aria-hidden="true">event</span>Seleccionar y reservar</a>
</div>
</article>}</div>
@if(Model.Vehiculos.Count==0){<p class="empty">No hay vehículos que cumplan estos filtros.</p>}
