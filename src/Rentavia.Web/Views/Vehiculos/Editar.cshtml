@model VehiculoForm
@{ ViewData["Title"] = "Guardar vehículo"; }
<div class="page-heading">
<div>
<h1>Guardar vehículo</h1>
<p class="lead-text">Completa los datos y revisa antes de confirmar.</p>
</div>
</div>
<div class="hint">Fotografía PNG o JPEG, hasta 2 MB. Editar la tarifa no cambia reservas anteriores.</div>
<div class="panel form-panel">
<form asp-action="Editar" method="post" enctype="multipart/form-data">
<div asp-validation-summary="All">
</div>
<input asp-for="Id" type="hidden" />
<input asp-for="Version" type="hidden" />
<div class="form-grid">
<div class="field">
<label asp-for="Placa">
</label>
<input asp-for="Placa" class="form-control" type="text"  />
<span asp-validation-for="Placa" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Marca">
</label>
<input asp-for="Marca" class="form-control" type="text"  />
<span asp-validation-for="Marca" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Modelo">
</label>
<input asp-for="Modelo" class="form-control" type="text"  />
<span asp-validation-for="Modelo" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Anio">
</label>
<input asp-for="Anio" class="form-control" type="number"  />
<span asp-validation-for="Anio" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="CategoriaId">
</label>
<select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="CategoriaId" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="SucursalId">
</label>
<select asp-for="SucursalId" class="form-select" asp-items="ViewBag.Sucursales">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="SucursalId" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="CapacidadPasajeros">
</label>
<input asp-for="CapacidadPasajeros" class="form-control" type="number"  />
<span asp-validation-for="CapacidadPasajeros" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="CapacidadMaletas">
</label>
<input asp-for="CapacidadMaletas" class="form-control" type="number"  />
<span asp-validation-for="CapacidadMaletas" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Kilometraje">
</label>
<input asp-for="Kilometraje" class="form-control" type="number"  />
<span asp-validation-for="Kilometraje" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Transmision">
</label>
<select asp-for="Transmision" class="form-select" asp-items="Html.GetEnumSelectList<Transmision>()">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="Transmision" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Estado">
</label>
<select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoVehiculo>()">
<option value="">Selecciona una opción</option>
</select>
<span asp-validation-for="Estado" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="TarifaDiaria">
</label>
<input asp-for="TarifaDiaria" class="form-control" type="number" step="0.01" />
<span asp-validation-for="TarifaDiaria" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Foto">
</label>
<input asp-for="Foto" class="form-control" type="file" accept="image/png,image/jpeg" />
<span asp-validation-for="Foto" class="text-danger">
</span>
</div>
</div>
<div class="form-actions">
<button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>Guardar</button>
<a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Volver</a>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
