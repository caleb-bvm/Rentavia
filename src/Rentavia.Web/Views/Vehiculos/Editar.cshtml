@model VehiculoForm
@{
    var nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo vehículo" : "Editar vehículo";
}
<div class="form-page">
    <a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Vehículos</a>
    <div class="panel form-panel">
        <header class="form-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">directions_car</span></span>
            <div>
                <span class="eyebrow">FLOTA</span>
                <h1>@ViewData["Title"]</h1>
                <p class="lead-text">Ficha del vehículo, su ubicación y la tarifa con la que se renta.</p>
            </div>
        </header>
        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <div class="form-content">
                <p class="form-note"><span class="icon" aria-hidden="true">info</span><span>Editar la tarifa no cambia las reservas anteriores.</span></p>
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input asp-for="Id" type="hidden" />
                <input asp-for="Version" type="hidden" />
                <fieldset class="form-section">
                    <legend>Identificación</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="Placa" class="rv-label"></label>
                            <input asp-for="Placa" class="rv-input" type="text" placeholder="Ej. P123-456" />
                            <span asp-validation-for="Placa" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Anio" class="rv-label"></label>
                            <input asp-for="Anio" class="rv-input" type="number" inputmode="numeric" />
                            <span asp-validation-for="Anio" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Marca" class="rv-label"></label>
                            <input asp-for="Marca" class="rv-input" type="text" placeholder="Ej. Toyota" />
                            <span asp-validation-for="Marca" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Modelo" class="rv-label"></label>
                            <input asp-for="Modelo" class="rv-input" type="text" placeholder="Ej. Corolla" />
                            <span asp-validation-for="Modelo" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="form-section">
                    <legend>Clasificación y ubicación</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="CategoriaId" class="rv-label"></label>
                            <select asp-for="CategoriaId" class="rv-select" asp-items="ViewBag.Categorias">
                                <option value="">Selecciona una categoría</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="SucursalId" class="rv-label"></label>
                            <select asp-for="SucursalId" class="rv-select" asp-items="ViewBag.Sucursales">
                                <option value="">Selecciona una sucursal</option>
                            </select>
                            <span asp-validation-for="SucursalId" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Transmision" class="rv-label"></label>
                            <select asp-for="Transmision" class="rv-select" asp-items="Html.GetEnumSelectList<Transmision>()">
                                <option value="">Selecciona una opción</option>
                            </select>
                            <span asp-validation-for="Transmision" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Estado" class="rv-label"></label>
                            <select asp-for="Estado" class="rv-select" asp-items="Html.GetEnumSelectList<EstadoVehiculo>()">
                                <option value="">Selecciona una opción</option>
                            </select>
                            <span class="rv-help">Solo los vehículos activos pueden rentarse.</span>
                            <span asp-validation-for="Estado" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="form-section">
                    <legend>Capacidad y uso</legend>
                    <div class="rv-grid rv-grid-3">
                        <div class="rv-field">
                            <label asp-for="CapacidadPasajeros" class="rv-label"></label>
                            <div class="rv-stepper">
                                <button class="rv-step" type="button" data-step="-1" aria-label="Quitar un pasajero"></button>
                                <input asp-for="CapacidadPasajeros" class="rv-input" type="number" inputmode="numeric" />
                                <button class="rv-step" type="button" data-step="1" aria-label="Agregar un pasajero"></button>
                            </div>
                            <span asp-validation-for="CapacidadPasajeros" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="CapacidadMaletas" class="rv-label"></label>
                            <div class="rv-stepper">
                                <button class="rv-step" type="button" data-step="-1" aria-label="Quitar una maleta"></button>
                                <input asp-for="CapacidadMaletas" class="rv-input" type="number" inputmode="numeric" />
                                <button class="rv-step" type="button" data-step="1" aria-label="Agregar una maleta"></button>
                            </div>
                            <span asp-validation-for="CapacidadMaletas" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Kilometraje" class="rv-label"></label>
                            <div class="rv-control">
                                <span class="icon" aria-hidden="true">speed</span>
                                <input asp-for="Kilometraje" class="rv-input" type="number" inputmode="numeric" />
                                <span class="rv-suffix">km</span>
                            </div>
                            <span asp-validation-for="Kilometraje" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="form-section">
                    <legend>Tarifa y fotografía</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="TarifaDiaria" class="rv-label">Tarifa diaria</label>
                            <div class="rv-control">
                                <span class="rv-affix">$</span>
                                <input asp-for="TarifaDiaria" class="rv-input" type="number" step="0.01" inputmode="decimal" />
                                <span class="rv-suffix">USD</span>
                            </div>
                            <span class="rv-help">Por cada período de 24 horas.</span>
                            <span asp-validation-for="TarifaDiaria" class="rv-error"></span>
                        </div>
                        <div class="rv-field rv-span-2">
                            <label asp-for="Foto" class="rv-label">Fotografía</label>
                            <div class="rv-drop">
                                <input asp-for="Foto" class="rv-drop-input" type="file" accept="image/png,image/jpeg" />
                                <span class="rv-drop-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg></span>
                                <img class="rv-drop-preview" alt="" />
                                <span class="rv-drop-text">
                                    <strong>Arrastra una imagen o haz clic para elegirla</strong>
                                    <small>@(nuevo ? "PNG o JPEG, hasta 2 MB" : "PNG o JPEG, hasta 2 MB. Si no eliges otra, se conserva la actual.")</small>
                                </span>
                            </div>
                            <span asp-validation-for="Foto" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <footer class="form-foot">
                <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>@(nuevo ? "Agregar a la flota" : "Guardar cambios")</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
