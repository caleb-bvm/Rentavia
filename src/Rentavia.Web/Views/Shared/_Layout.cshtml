<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f0f0f" />
    <title>@ViewData["Title"] · Rentavía</title>
    <script>
        // Aplica el tema guardado antes de pintar, para evitar un destello del otro esquema
        try {
            var tema = localStorage.getItem("rentavia-tema");
            if (tema === "light" || tema === "dark") document.documentElement.dataset.theme = tema;
        } catch (e) { }
    </script>
    <link rel="preload" href="~/fonts/material-symbols-rounded.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var esAdministrador = User.IsInRole("Administrador");
    // El menú se agrupa por tarea: primero lo que se hace cada día (rentar), después la flota y la configuración.
    // Cada opción: controlador, acción, texto e ícono de Material Symbols.
    var grupos = new List<(string Titulo, (string Controlador, string Accion, string Texto, string Icono)[] Opciones)>
    {
        ("", [("Home", "Index", "Inicio", "space_dashboard")]),
        ("Rentar", [
            ("Disponibilidad", "Index", "Buscar vehículo", "event_available"),
            ("Recomendaciones", "Index", "Recomendador IA", "auto_awesome"),
            ("Reservas", "Index", "Reservas", "event"),
            ("Alquileres", "Index", "Alquileres", "car_rental")
        ]),
        ("Flota y clientes", [
            ("Vehiculos", "Index", "Vehículos", "directions_car"),
            ("Mantenimientos", "Index", "Mantenimiento", "build"),
            ("Clientes", "Index", "Clientes", "group")
        ]),
        ("Configuración", [
            ("Categorias", "Index", "Categorías", "category"),
            ("Sucursales", "Index", "Sucursales", "store")
        ])
    };
    if (esAdministrador)
    {
        grupos.Add(("Administración", [
            ("Reportes", "Index", "Reportes", "analytics"),
            ("Reportes", "Auditoria", "Auditoría", "policy"),
            ("Usuarios", "Index", "Usuarios", "manage_accounts")
        ]));
    }
    // Reportes tiene dos opciones en el menú; en los demás basta con el controlador
    bool Activa((string Controlador, string Accion, string Texto, string Icono) o) =>
        controlador == o.Controlador && (controlador != "Reportes" || accion == o.Accion);
    var grupoActual = grupos.FirstOrDefault(g => g.Opciones.Any(Activa));
    var opcionActual = grupoActual.Opciones?.FirstOrDefault(Activa);
    var titulo = ViewData["Title"]?.ToString();
    // En Inicio y en las pantallas del ciclo de renta el atajo "Nueva renta" sobra
    var enFlujo = controlador is "Home" or "Disponibilidad" or "Recomendaciones" || (controlador == "Reservas" && accion == "Editar");
}
<div class="app-shell @(User.Identity?.IsAuthenticated == true ? "" : "public-shell")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="sidebar" id="menu">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">RV</span>
                <span>RENTAVÍA<small>GESTIÓN DE FLOTA</small></span>
            </a>
            <nav aria-label="Navegación principal">
                @foreach (var grupo in grupos)
                {
                    @if (grupo.Titulo != "")
                    {
                        <span class="nav-caption">@grupo.Titulo.ToUpper()</span>
                    }
                    @foreach (var o in grupo.Opciones)
                    {
                        <a class="@(Activa(o) ? "active" : "")" asp-controller="@o.Controlador" asp-action="@o.Accion" aria-current="@(Activa(o) ? "page" : null)">
                            <span class="icon" aria-hidden="true">@o.Icono</span>@o.Texto
                        </a>
                    }
                }
            </nav>
            <div class="sidebar-bottom">
                <div class="user-chip">
                    <span class="avatar"><span class="icon" aria-hidden="true">person</span></span>
                    <small>@User.Identity?.Name</small>
                </div>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button class="btn btn-outline-secondary logout"><span class="icon" aria-hidden="true">logout</span>Cerrar sesión</button>
                </form>
            </div>
        </aside>
        <div class="scrim" data-nav-toggle></div>
    }
    <main class="main-content" id="contenido">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <header class="topbar">
                <button class="menu-toggle" type="button" data-nav-toggle aria-controls="menu" aria-label="Abrir menú">
                    <span class="icon" aria-hidden="true">menu</span>
                </button>
                @* Migas: sección del menú › opción › pantalla actual, para saber siempre dónde se está *@
                <nav class="topbar-title breadcrumbs" aria-label="Ubicación">
                    @if (grupoActual.Titulo is { Length: > 0 })
                    {
                        <span class="crumb-section">@grupoActual.Titulo</span>
                    }
                    @if (opcionActual is { } actual)
                    {
                        @if (titulo is not null && titulo != actual.Texto && controlador != "Home")
                        {
                            <a class="crumb-section" asp-controller="@actual.Controlador" asp-action="@actual.Accion">@actual.Texto</a>
                            <span aria-current="page">@titulo</span>
                        }
                        else
                        {
                            <span aria-current="page">@actual.Texto</span>
                        }
                    }
                    else if (titulo is not null)
                    {
                        <span aria-current="page">@titulo</span>
                    }
                </nav>
                @if (!enFlujo)
                {
                    <a class="btn btn-tonal btn-sm topbar-cta" asp-controller="Disponibilidad" asp-action="Index" title="Buscar un vehículo libre y reservarlo">
                        <span class="icon" aria-hidden="true">add</span><span class="topbar-cta-text">Nueva renta</span>
                    </a>
                }
                <partial name="_BotonTema" model="string.Empty" />
            </header>
            <div class="content-wrap">
                @RenderBody()
            </div>
        }
        else
        {
            <partial name="_BotonTema" model='"theme-toggle-floating"' />
            @RenderBody()
        }
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success" role="status"><span class="icon" aria-hidden="true">check_circle</span>@exito</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert"><span class="icon" aria-hidden="true">error</span>@error</div>
        }
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
