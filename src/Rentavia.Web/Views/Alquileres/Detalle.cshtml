@model Alquiler
@{ ViewData["Title"] = "Detalle de alquiler"; var saldo = Model.MontoTotal-Model.Pagos.Sum(p=>p.Monto); var abierto = Model.Estado==EstadoAlquiler.Abierto; }
<a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Alquileres</a>
<div class="page-heading">
<div>
<span class="eyebrow">CONTRATO</span>
<h1>Alquiler #@Model.Id</h1>
<p class="lead-text">Reserva #@Model.ReservaId · <span class="state">@(abierto ? "En curso" : "Cerrado")</span></p>
</div>
<div class="form-actions">
<button class="btn btn-outline-secondary" onclick="window.print()"><span class="icon" aria-hidden="true">print</span>Imprimir</button> @if(Model.Estado==EstadoAlquiler.Abierto){<a class="btn btn-primary" asp-action="Devolver" asp-route-id="@Model.Id"><span class="icon" aria-hidden="true">assignment_return</span>Registrar devolución</a>}</div>
</div>
@if(abierto){<partial name="_PasosRenta" model="4" />}
else if(saldo>0){<div class="hint">El vehículo ya fue devuelto, pero queda un saldo de @Presentacion.Dinero(saldo). Regístralo abajo para completar el cobro.</div>}
<div class="panel details-grid">
<dl>
<dt>Cliente</dt>
<dd>@Model.Reserva.Cliente.Nombre @Model.Reserva.Cliente.Apellido</dd>
<dt>Vehículo</dt>
<dd>@Model.Vehiculo.Placa · @Model.Vehiculo.Marca @Model.Vehiculo.Modelo</dd>
<dt>Período acordado</dt>
<dd>@Presentacion.Fecha(Model.Reserva.InicioUtc) → @Presentacion.Fecha(Model.Reserva.FinUtc)</dd>
<dt>Tarifa / días</dt>
<dd>@Presentacion.Dinero(Model.Reserva.TarifaDiaria) / @Model.Reserva.Dias</dd>
<dt>Total / saldo</dt>
<dd>@Presentacion.Dinero(Model.MontoTotal) / @Presentacion.Dinero(saldo)</dd>
</dl>
<dl>
<dt>Entrega</dt>
<dd>@Presentacion.Fecha(Model.EntregaUtc) · @Model.KilometrajeInicial km · @Model.CombustibleInicial% combustible</dd>
<dt>Inspección de entrega</dt>
<dd>@Model.ObservacionesEntrega</dd>
<dt>Devolución</dt>
@if(Model.DevolucionUtc.HasValue){<dd>@Presentacion.Fecha(Model.DevolucionUtc.Value) · @Model.KilometrajeFinal km · @Model.CombustibleFinal%</dd>
<dt>Inspección de devolución</dt>
<dd>@Model.ObservacionesDevolucion</dd>
<dt>Cargo adicional</dt>
<dd>@Presentacion.Dinero(Model.CargoAdicional)@(string.IsNullOrEmpty(Model.ConceptoCargo) ? "" : " · " + Model.ConceptoCargo)</dd>}
else{<dd>Pendiente: el vehículo sigue con el cliente.</dd>}
</dl>
</div>
@if(Model.Estado==EstadoAlquiler.Abierto && Model.Reserva.FinUtc<DateTimeOffset.UtcNow){<div class="hint">Devolución atrasada. Revisa las reservas posteriores y coordina su resolución; el vehículo no se ofrece para nuevas operaciones hasta devolverse.</div>}
<div class="panel">
<h2><span class="icon" aria-hidden="true">payments</span>Pagos registrados</h2>
@if(Model.Pagos.Count>0){<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th>Fecha</th>
<th>Monto</th>
<th>Método</th>
<th>Referencia</th>
</tr>
</thead>
<tbody>@foreach(var p in Model.Pagos){<tr>
<td>@Presentacion.Fecha(p.FechaUtc)</td>
<td>@Presentacion.Dinero(p.Monto)</td>
<td>@p.Metodo</td>
<td>@p.Referencia</td>
</tr>}</tbody>
</table>
</div>}
else{<p class="empty">Todavía no hay pagos.</p>}
@if(saldo>0){<form asp-action="Pago" method="post" class="no-print payment-form">
<h3>Registrar un pago</h3>
<input name="AlquilerId" value="@Model.Id" type="hidden"/>
<div class="rv-grid rv-fluid">
<div class="rv-field is-required">
<label for="monto" class="rv-label">Monto</label>
<div class="rv-control">
<span class="rv-affix">$</span>
<input id="monto" name="Monto" class="rv-input" type="number" step="0.01" min="0.01" max="@saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)" value="@saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)" inputmode="decimal" required/>
<span class="rv-suffix">USD</span>
</div>
<span class="rv-help">Saldo pendiente: @Presentacion.Dinero(saldo)</span>
</div>
<div class="rv-field is-required">
<label for="metodo" class="rv-label">Método</label>
<select id="metodo" name="Metodo" class="rv-select">
<option>Efectivo</option>
<option>Transferencia</option>
<option>Tarjeta</option>
</select>
</div>
<div class="rv-field">
<label for="referencia" class="rv-label">Referencia</label>
<input id="referencia" name="Referencia" maxlength="100" class="rv-input" placeholder="N.º de recibo o transacción"/>
</div>
</div>
<div class="form-actions"><button class="btn btn-primary"><span class="icon" aria-hidden="true">add_card</span>Registrar pago</button></div>
</form>}
else{<p class="hint">Alquiler pagado por completo.</p>}
</div>

