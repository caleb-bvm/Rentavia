@model DevolucionForm
@{ ViewData["Title"] = "Registrar devolución"; }
<div class="page-heading">
<div>
<h1>Registrar devolución</h1>
<p class="lead-text">Completa los datos y revisa antes de confirmar.</p>
</div>
</div>
<div class="hint">Los cargos son registrados por el empleado con un concepto. No se aplican penalizaciones automáticas. Cerrar la operación libera el vehículo; el saldo se consulta en el detalle.</div>
<div class="panel form-panel">
<form asp-action="Devolver" method="post" >
<div asp-validation-summary="All">
</div>
<input asp-for="Id" type="hidden" />
<input asp-for="Version" type="hidden" />
<div class="form-grid">
<div class="field">
<label asp-for="Kilometraje">
</label>
<input asp-for="Kilometraje" class="form-control" type="number"  />
<span asp-validation-for="Kilometraje" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Combustible">
</label>
<input asp-for="Combustible" class="form-control" type="number"  />
<span asp-validation-for="Combustible" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Cargo">
</label>
<input asp-for="Cargo" class="form-control" type="number" step="0.01" />
<span asp-validation-for="Cargo" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Concepto">
</label>
<input asp-for="Concepto" class="form-control" type="text"  />
<span asp-validation-for="Concepto" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Observaciones">
</label>
<textarea asp-for="Observaciones" class="form-control" rows="3">
</textarea>
<span asp-validation-for="Observaciones" class="text-danger">
</span>
</div>
</div>
<div class="form-actions">
<button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>Cerrar alquiler</button>
<a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Volver</a>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
