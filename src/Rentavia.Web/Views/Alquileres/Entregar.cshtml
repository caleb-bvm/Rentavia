@model EntregaForm
@{ ViewData["Title"] = "Registrar entrega"; }
<div class="form-page">
    <a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Alquileres</a>
    <div class="panel form-panel">
        <header class="form-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">key</span></span>
            <div>
                <span class="eyebrow">ALQUILERES</span>
                <h1>Registrar entrega</h1>
                <p class="lead-text">Anota el estado en que el vehículo sale de la agencia.</p>
            </div>
        </header>
        <form asp-action="Entregar" method="post">
            <div class="form-content">
                <p class="form-note"><span class="icon" aria-hidden="true">info</span><span>La entrega se permite desde cinco minutos antes del inicio y mientras la reserva siga vigente.</span></p>
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input asp-for="ReservaId" type="hidden" />
                <input asp-for="Version" type="hidden" />
                <fieldset class="form-section">
                    <legend>Inspección de salida</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="Kilometraje" class="rv-label"></label>
                            <div class="rv-control">
                                <span class="icon" aria-hidden="true">speed</span>
                                <input asp-for="Kilometraje" class="rv-input" type="number" inputmode="numeric" />
                                <span class="rv-suffix">km</span>
                            </div>
                            <span asp-validation-for="Kilometraje" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Combustible" class="rv-label">Combustible</label>
                            <div class="rv-range">
                                <input asp-for="Combustible" type="range" min="0" max="100" step="5" />
                                <output for="Combustible">@Model.Combustible%</output>
                            </div>
                            <span asp-validation-for="Combustible" class="rv-error"></span>
                        </div>
                        <div class="rv-field rv-span-2">
                            <label asp-for="Observaciones" class="rv-label"></label>
                            <textarea asp-for="Observaciones" class="rv-textarea" rows="3" placeholder="Rayones, golpes, limpieza, accesorios entregados…"></textarea>
                            <span asp-validation-for="Observaciones" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <footer class="form-foot">
                <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">key</span>Entregar vehículo</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
