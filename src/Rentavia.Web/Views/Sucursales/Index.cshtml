@model List<Sucursal>
@{ ViewData["Title"] = "Sucursales"; }
<div class="page-heading">
<div>
<h1>Sucursales</h1>
<p class="lead-text">Ubicaciones de la agencia.</p>
</div>@if(User.IsInRole("Administrador")){<a asp-action="Editar" class="btn btn-primary"><span class="icon" aria-hidden="true">add</span>Nueva sucursal</a>}</div>
<div class="panel table-responsive">
<table class="table">
<thead>
<tr>
<th>Nombre</th>
<th>Dirección</th>
<th>Teléfono</th>
<th>Estado</th>
<th>
</th>
</tr>
</thead>
<tbody>
@foreach(var s in Model){<tr>
<td>@s.Nombre</td>
<td>@s.Direccion</td>
<td>@s.Telefono</td>
<td>
<span class="state">@(s.Activa ? "Activa" : "Inactiva")</span>
</td>
<td>@if(User.IsInRole("Administrador")){<a asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary"><span class="icon" aria-hidden="true">edit</span>Editar</a> <form asp-action="Eliminar" method="post" data-confirm="¿Eliminar esta sucursal?">
<input name="id" value="@s.Id" type="hidden"/>
<button class="btn btn-sm btn-outline-danger"><span class="icon" aria-hidden="true">delete</span>Eliminar</button>
</form>}</td>
</tr>}
</tbody>
</table>@if(Model.Count==0){<p class="empty">Todavía no hay sucursales.</p>}</div>
