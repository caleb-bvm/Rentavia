@model ReservaForm
@{
    var nueva = Model.Id == 0;
    ViewData["Title"] = nueva ? "Nueva reserva" : "Editar reserva";
}
<div class="form-page">
    <a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Reservas</a>
    <div class="panel form-panel">
        <header class="form-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">event</span></span>
            <div>
                <span class="eyebrow">RESERVAS</span>
                <h1>@ViewData["Title"]</h1>
                <p class="lead-text">Aparta un vehículo para un cliente durante un período.</p>
            </div>
        </header>
        <form asp-action="Editar" method="post">
            <div class="form-content">
                <p class="form-note"><span class="icon" aria-hidden="true">info</span><span>Horario UTC-6. Cobro demo en USD por períodos de 24 horas, redondeados hacia arriba. Al editar, se conservan el vehículo y la tarifa acordada; para cambiarlo, cancela y crea otra reserva.</span></p>
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input asp-for="Id" type="hidden" />
                <input asp-for="Version" type="hidden" />
                <fieldset class="form-section">
                    <legend>Cliente y vehículo</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="ClienteId" class="rv-label"></label>
                            <select asp-for="ClienteId" class="rv-select" asp-items="ViewBag.Clientes">
                                <option value="">Selecciona un cliente</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="VehiculoId" class="rv-label"></label>
                            <select asp-for="VehiculoId" class="rv-select" asp-items="ViewBag.Vehiculos">
                                <option value="">Selecciona un vehículo</option>
                            </select>
                            <span asp-validation-for="VehiculoId" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="form-section">
                    <legend>Período</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="Inicio" class="rv-label">Recogida</label>
                            <input asp-for="Inicio" class="rv-input" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Inicio" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Fin" class="rv-label">Devolución</label>
                            <input asp-for="Fin" class="rv-input" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Fin" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <footer class="form-foot">
                <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>@(nueva ? "Confirmar reserva" : "Guardar cambios")</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
