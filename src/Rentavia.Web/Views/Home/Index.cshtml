@model PanelModel
@{ ViewData["Title"] = "Inicio"; }
<div class="page-heading">
    <div>
        <span class="eyebrow">TU OPERACIÓN, A UN VISTAZO</span>
        <h1>Inicio</h1>
        <p class="lead-text">Lo que necesita atención hoy y el camino para atender a un nuevo cliente.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Disponibilidad" asp-action="Index"><span class="icon" aria-hidden="true">add</span>Nueva renta</a>
</div>
<div class="metrics">
    <a class="metric" asp-controller="Disponibilidad" asp-action="Index">
        <span class="icon" aria-hidden="true">directions_car</span>
        <strong>@Model.VehiculosLibres</strong>
        <span>Vehículos libres ahora</span>
    </a>
    <a class="metric" asp-controller="Reservas" asp-action="Index" asp-route-estado="por-entregar">
        <span class="icon" aria-hidden="true">key</span>
        <strong>@Model.ReservasPorEntregar</strong>
        <span>Reservas por entregar</span>
    </a>
    <a class="metric" asp-controller="Alquileres" asp-action="Index" asp-route-estado="en-curso">
        <span class="icon" aria-hidden="true">car_rental</span>
        <strong>@Model.AlquileresAbiertos</strong>
        <span>Alquileres en curso</span>
    </a>
    <a class="metric @(Model.DevolucionesAtrasadas > 0 ? "is-alert" : "")" asp-controller="Alquileres" asp-action="Index" asp-route-estado="atrasados">
        <span class="icon" aria-hidden="true">schedule</span>
        <strong>@Model.DevolucionesAtrasadas</strong>
        <span>Devoluciones atrasadas</span>
    </a>
</div>
<section class="panel">
    <h2><span class="icon" aria-hidden="true">info</span>Cómo se atiende una renta</h2>
    <p class="lead-text">Cada renta pasa por cuatro pasos. Toca un paso para ir directo a esa pantalla.</p>
    <partial name="_PasosRenta" model="0" />
</section>
<div class="panel-pair">
    <section class="panel">
        <div class="page-heading">
            <h2><span class="icon" aria-hidden="true">key</span>Próximas entregas</h2>
            <a class="btn btn-sm" asp-controller="Reservas" asp-action="Index" asp-route-estado="por-entregar">Ver todas<span class="icon" aria-hidden="true">arrow_forward</span></a>
        </div>
        @if (Model.Entregas.Count == 0)
        {
            <p class="empty">No hay reservas pendientes de entregar.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var r in Model.Entregas)
                {
                    <li>
                        <div>
                            <strong>@r.Cliente.Nombre @r.Cliente.Apellido</strong>
                            <small>@r.Vehiculo.Placa · @r.Vehiculo.Marca @r.Vehiculo.Modelo</small>
                            <small>Recoge el @Presentacion.Fecha(r.InicioUtc)</small>
                        </div>
                        <a class="btn btn-sm btn-primary" asp-controller="Alquileres" asp-action="Entregar" asp-route-reservaId="@r.Id"><span class="icon" aria-hidden="true">key</span>Entregar</a>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="panel">
        <div class="page-heading">
            <h2><span class="icon" aria-hidden="true">assignment_return</span>Próximas devoluciones</h2>
            <a class="btn btn-sm" asp-controller="Alquileres" asp-action="Index" asp-route-estado="en-curso">Ver todas<span class="icon" aria-hidden="true">arrow_forward</span></a>
        </div>
        @if (Model.Devoluciones.Count == 0)
        {
            <p class="empty">No hay devoluciones pendientes.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var a in Model.Devoluciones)
                {
                    var atrasado = a.Reserva.FinUtc < DateTimeOffset.UtcNow;
                    <li>
                        <div>
                            <strong>@a.Vehiculo.Placa · @a.Vehiculo.Modelo</strong>
                            <small>Regresa el @Presentacion.Fecha(a.Reserva.FinUtc)</small>
                            <span><span class="state">@(atrasado ? "Atrasado" : "En curso")</span></span>
                        </div>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Alquileres" asp-action="Devolver" asp-route-id="@a.Id"><span class="icon" aria-hidden="true">assignment_return</span>Devolver</a>
                    </li>
                }
            </ul>
        }
    </section>
</div>
