@model CategoriaForm
@{
    var nueva = Model.Id == 0;
    ViewData["Title"] = nueva ? "Nueva categoría" : "Editar categoría";
}
<div class="form-page">
    <a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Categorías</a>
    <div class="panel form-panel">
        <header class="form-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">category</span></span>
            <div>
                <span class="eyebrow">CATÁLOGO</span>
                <h1>@ViewData["Title"]</h1>
                <p class="lead-text">Agrupa los vehículos por tipo para filtrarlos y recomendarlos.</p>
            </div>
        </header>
        <form asp-action="Editar" method="post">
            <div class="form-content">
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input asp-for="Id" type="hidden" />
                <fieldset class="form-section">
                    <legend>Datos de la categoría</legend>
                    <div class="rv-grid">
                        <div class="rv-field rv-span-2">
                            <label asp-for="Nombre" class="rv-label"></label>
                            <input asp-for="Nombre" class="rv-input" type="text" placeholder="Ej. SUV compacto" />
                            <span asp-validation-for="Nombre" class="rv-error"></span>
                        </div>
                        <div class="rv-field rv-span-2">
                            <label asp-for="Descripcion" class="rv-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="rv-textarea" rows="3" placeholder="Qué tipo de vehículos incluye y para quién son"></textarea>
                            <span class="rv-help">Hasta 150 caracteres.</span>
                            <span asp-validation-for="Descripcion" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <footer class="form-foot">
                <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>@(nueva ? "Crear categoría" : "Guardar cambios")</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
