@model CategoriaForm
@{ ViewData["Title"] = "Guardar categoría"; }
<div class="page-heading">
<div>
<h1>Guardar categoría</h1>
<p class="lead-text">Completa los datos y revisa antes de confirmar.</p>
</div>
</div>

<div class="panel form-panel">
<form asp-action="Editar" method="post" >
<div asp-validation-summary="All">
</div>
<input asp-for="Id" type="hidden" />
<div class="form-grid">
<div class="field">
<label asp-for="Nombre">
</label>
<input asp-for="Nombre" class="form-control" type="text"  />
<span asp-validation-for="Nombre" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Descripcion">
</label>
<textarea asp-for="Descripcion" class="form-control" rows="3">
</textarea>
<span asp-validation-for="Descripcion" class="text-danger">
</span>
</div>
</div>
<div class="form-actions">
<button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>Guardar</button>
<a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Volver</a>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
