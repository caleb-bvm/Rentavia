@model List<Categoria>
@{ ViewData["Title"] = "Categorías"; }
<div class="page-heading">
<div>
<h1>Categorías</h1>
<p class="lead-text">Organiza los tipos de vehículos de la flota.</p>
</div>@if(User.IsInRole("Administrador")){<a asp-action="Editar" class="btn btn-primary"><span class="icon" aria-hidden="true">add</span>Nueva categoría</a>}</div>
<div class="panel table-responsive">
<table class="table">
<thead>
<tr>
<th>Nombre</th>
<th>Descripción</th>
<th>Acciones</th>
</tr>
</thead>
<tbody>
@foreach(var c in Model){<tr>
<td>@c.Nombre</td>
<td>@c.Descripcion</td>
<td>@if(User.IsInRole("Administrador")){<a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary"><span class="icon" aria-hidden="true">edit</span>Editar</a> <form asp-action="Eliminar" method="post" data-confirm="¿Eliminar esta categoría?">
<input name="id" value="@c.Id" type="hidden"/>
<button class="btn btn-sm btn-outline-danger"><span class="icon" aria-hidden="true">delete</span>Eliminar</button>
</form>}</td>
</tr>}
</tbody>
</table>@if(Model.Count==0){<p class="empty">Todavía no hay categorías.</p>}</div>
