@model ReporteModel
@{ ViewData["Title"] = "Reportes"; }
<div class="page-heading">
<div>
<span class="eyebrow">ADMINISTRACIÓN</span>
<h1>Reportes</h1>
<p class="lead-text">Resumen de registros del período seleccionado.</p>
</div>
</div>
<p class="print-only">Período: @Model.Desde.ToString("dd/MM/yyyy") – @Model.Hasta.ToString("dd/MM/yyyy")</p>
<div class="panel filter-panel no-print">
    <form asp-action="Index" method="get" data-rango-fechas data-rango-max-dias="365">
        <header class="filter-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">analytics</span></span>
            <div>
                <h2>Período del reporte</h2>
                <p>Elige un atajo o indica las fechas exactas; el período puede abarcar hasta un año.</p>
            </div>
        </header>
        <div class="filter-body">
            <div asp-validation-summary="ModelOnly" class="form-alert"></div>
            <div class="filter-groups">
                <fieldset class="filter-group">
                    <legend>Fechas</legend>
                    <div class="rv-grid rv-fluid">
                        <div class="rv-field">
                            <label asp-for="Desde" class="rv-label"></label>
                            <div class="rv-control">
                                <span class="icon" aria-hidden="true">event</span>
                                <input asp-for="Desde" type="date" class="rv-input" data-rango-inicio />
                            </div>
                            <span asp-validation-for="Desde" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Hasta" class="rv-label"></label>
                            <div class="rv-control">
                                <span class="icon" aria-hidden="true">event</span>
                                <input asp-for="Hasta" type="date" class="rv-input" data-rango-fin />
                            </div>
                            <span asp-validation-for="Hasta" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="filter-group">
                    <legend>Atajos</legend>
                    <div class="rv-presets">
                        <button type="button" class="rv-preset" data-preset="7">Últimos 7 días</button>
                        <button type="button" class="rv-preset" data-preset="30">Últimos 30 días</button>
                        <button type="button" class="rv-preset" data-preset="mes">Este mes</button>
                        <button type="button" class="rv-preset" data-preset="anio">Este año</button>
                    </div>
                    <p class="rv-help">Al elegir un atajo, el reporte se actualiza.</p>
                </fieldset>
            </div>
        </div>
        <footer class="filter-foot">
            <p class="rv-summary" data-duracion aria-live="polite"></p>
            <div class="filter-actions">
                <button type="button" class="btn btn-quiet" onclick="window.print()"><span class="icon" aria-hidden="true">print</span>Imprimir</button>
                <button class="btn btn-primary"><span class="icon" aria-hidden="true">search</span>Consultar</button>
            </div>
        </footer>
    </form>
</div>
<div class="metrics">
<div class="metric">
<span class="icon" aria-hidden="true">payments</span>
<strong>@Presentacion.Dinero(Model.Ingresos)</strong>
<span>Pagos registrados</span>
</div>
<div class="metric">
<span class="icon" aria-hidden="true">event</span>
<strong>@Model.Reservas</strong>
<span>Reservas creadas</span>
</div>
<div class="metric">
<span class="icon" aria-hidden="true">key</span>
<strong>@Model.Alquileres</strong>
<span>Entregas registradas</span>
</div>
<div class="metric">
<span class="icon" aria-hidden="true">build</span>
<strong>@Presentacion.Dinero(Model.CostoMantenimiento)</strong>
<span>Costo de mantenimiento programado</span>
</div>
</div>
<div class="panel">
<h2><span class="icon" aria-hidden="true">receipt_long</span>Detalle de ingresos</h2>
<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th>Fecha</th>
<th>Alquiler</th>
<th>Monto</th>
<th>Método</th>
</tr>
</thead>
<tbody>@foreach(var p in Model.Pagos){<tr>
<td>@Presentacion.Fecha(p.FechaUtc)</td>
<td>
<a asp-controller="Alquileres" asp-action="Detalle" asp-route-id="@p.AlquilerId">#@p.AlquilerId</a>
</td>
<td>@Presentacion.Dinero(p.Monto)</td>
<td>@p.Metodo</td>
</tr>}</tbody>
</table>
</div>
</div>

<div class="panel">
    <h2><span class="icon" aria-hidden="true">speed</span>Utilización observada por vehículo</h2>
    <p class="lead-text">Horas entre entrega y devolución dentro del período, divididas entre sus horas totales. Los alquileres abiertos se cuentan hasta el momento de la consulta.</p>
    <div class="table-responsive"><table class="table">
        <thead><tr><th>Placa</th><th>Horas de uso</th><th>Utilización</th></tr></thead>
        <tbody>@foreach (var uso in Model.Uso) { <tr><td>@uso.Placa</td><td>@uso.Horas</td><td>@uso.Porcentaje %</td></tr> }</tbody>
    </table></div>
</div>
