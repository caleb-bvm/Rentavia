@model ClienteForm
@{ ViewData["Title"] = "Guardar cliente"; }
<div class="page-heading">
<div>
<h1>Guardar cliente</h1>
<p class="lead-text">Completa los datos y revisa antes de confirmar.</p>
</div>
</div>
<div class="hint">Usa datos ficticios durante la demostración. La licencia se verifica al reservar y entregar.</div>
<div class="panel form-panel">
<form asp-action="Editar" method="post" >
<div asp-validation-summary="All">
</div>
<input asp-for="Id" type="hidden" />
<input asp-for="Version" type="hidden" />
<div class="form-grid">
<div class="field">
<label asp-for="Nombre">
</label>
<input asp-for="Nombre" class="form-control" type="text"  />
<span asp-validation-for="Nombre" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Apellido">
</label>
<input asp-for="Apellido" class="form-control" type="text"  />
<span asp-validation-for="Apellido" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="TipoDocumento">
</label>
<input asp-for="TipoDocumento" class="form-control" type="text"  />
<span asp-validation-for="TipoDocumento" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="NumeroDocumento">
</label>
<input asp-for="NumeroDocumento" class="form-control" type="text"  />
<span asp-validation-for="NumeroDocumento" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Licencia">
</label>
<input asp-for="Licencia" class="form-control" type="text"  />
<span asp-validation-for="Licencia" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="VencimientoLicencia">
</label>
<input asp-for="VencimientoLicencia" class="form-control" type="date"  />
<span asp-validation-for="VencimientoLicencia" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Telefono">
</label>
<input asp-for="Telefono" class="form-control" type="text"  />
<span asp-validation-for="Telefono" class="text-danger">
</span>
</div>
<div class="field">
<label asp-for="Correo">
</label>
<input asp-for="Correo" class="form-control" type="email"  />
<span asp-validation-for="Correo" class="text-danger">
</span>
</div>
<div class="form-check field">
<input asp-for="Activo" class="form-check-input" />
<label asp-for="Activo" class="form-check-label">
</label>
</div>
</div>
<div class="form-actions">
<button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>Guardar</button>
<a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Volver</a>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
