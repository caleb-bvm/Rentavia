@model ClienteForm
@{
    var nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo cliente" : "Editar cliente";
    var volver = ViewBag.Volver as string;
}
<div class="form-page">
    @if (volver is not null)
    {
        <a class="back-link" href="@volver"><span class="icon" aria-hidden="true">arrow_back</span>Volver a la reserva</a>
    }
    else
    {
        <a class="back-link" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>Clientes</a>
    }
    <div class="panel form-panel">
        <header class="form-head">
            <span class="form-head-icon" aria-hidden="true"><span class="icon">group</span></span>
            <div>
                <span class="eyebrow">CLIENTES</span>
                <h1>@ViewData["Title"]</h1>
                <p class="lead-text">Datos de identidad y contacto de quien renta.</p>
            </div>
        </header>
        <form asp-action="Editar" method="post">
            <div class="form-content">
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input asp-for="Id" type="hidden" />
                <input asp-for="Version" type="hidden" />
                @if (volver is not null)
                {
                    <input type="hidden" name="volver" value="@volver" />
                    <p class="form-note"><span class="icon" aria-hidden="true">info</span><span>Al guardar regresarás a la reserva con este cliente ya seleccionado.</span></p>
                }
                <fieldset class="form-section">
                    <legend>Identidad</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="Nombre" class="rv-label"></label>
                            <input asp-for="Nombre" class="rv-input" type="text" autocomplete="given-name" />
                            <span asp-validation-for="Nombre" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Apellido" class="rv-label"></label>
                            <input asp-for="Apellido" class="rv-input" type="text" autocomplete="family-name" />
                            <span asp-validation-for="Apellido" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="TipoDocumento" class="rv-label"></label>
                            <select asp-for="TipoDocumento" class="rv-select" data-tipo-documento>
                                <option value="@ClienteForm.Dui">DUI</option>
                                <option value="@ClienteForm.Pasaporte">Pasaporte</option>
                            </select>
                            <span asp-validation-for="TipoDocumento" class="rv-error"></span>
                        </div>
                        @* Solo se muestra la caja del documento elegido *@
                        <div class="rv-field is-required" data-documento="@ClienteForm.Dui">
                            <label asp-for="NumeroDui" class="rv-label">Número de DUI</label>
                            <input asp-for="NumeroDui" class="rv-input" type="text" inputmode="numeric" placeholder="00000000-0" maxlength="10" />
                            <span asp-validation-for="NumeroDui" class="rv-error"></span>
                        </div>
                        <div class="rv-field is-required" data-documento="@ClienteForm.Pasaporte">
                            <label asp-for="NumeroPasaporte" class="rv-label">Número de pasaporte</label>
                            <input asp-for="NumeroPasaporte" class="rv-input" type="text" maxlength="30" />
                            <span asp-validation-for="NumeroPasaporte" class="rv-error"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="form-section">
                    <legend>Contacto</legend>
                    <div class="rv-grid">
                        <div class="rv-field">
                            <label asp-for="Telefono" class="rv-label"></label>
                            <input asp-for="Telefono" class="rv-input" type="tel" autocomplete="tel" />
                            <span asp-validation-for="Telefono" class="rv-error"></span>
                        </div>
                        <div class="rv-field">
                            <label asp-for="Correo" class="rv-label">Correo electrónico</label>
                            <div class="rv-control">
                                <span class="rv-affix">@@</span>
                                <input asp-for="Correo" class="rv-input" type="email" autocomplete="email" placeholder="nombre@correo.com" />
                            </div>
                            <span asp-validation-for="Correo" class="rv-error"></span>
                        </div>
                        <label class="rv-switch rv-span-2">
                            <input asp-for="Activo" class="rv-switch-input" />
                            <span class="rv-switch-text">
                                <strong>Cliente activo</strong>
                                <small>Solo los clientes activos pueden reservar y recibir vehículos.</small>
                            </span>
                            <span class="rv-switch-track" aria-hidden="true"></span>
                        </label>
                    </div>
                </fieldset>
            </div>
            <footer class="form-foot">
                <a class="btn btn-quiet" href="@(volver ?? Url.Action("Index"))">Cancelar</a>
                <button class="btn btn-primary" type="submit"><span class="icon" aria-hidden="true">check</span>@(nuevo ? "Registrar cliente" : "Guardar cambios")</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
// Muestra solo la caja del documento elegido; la otra se limpia y se desactiva.
const tipo = document.querySelector("[data-tipo-documento]");
function cambiarDocumento() {
    document.querySelectorAll("[data-documento]").forEach(campo => {
        const elegido = campo.dataset.documento === tipo.value;
        const input = campo.querySelector("input");
        campo.hidden = !elegido;
        input.disabled = !elegido;
        if (!elegido) input.value = "";
    });
}
tipo.addEventListener("change", cambiarDocumento);
cambiarDocumento();
</script>
}
