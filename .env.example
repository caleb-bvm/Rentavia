# Docker Compose carga .env cuando se usa --env-file .env.
# Para generar contraseñas aleatorias: ./scripts/Preparar-env.ps1
# Cambia el correo y configura las claves reales SOLO en .env, que no se comparte.
MSSQL_SA_PASSWORD=
ADMIN_EMAIL=admin@rentavia.test
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WEB_PORT=8080
SQL_PORT=14330

# dotnet run local NO carga .env automáticamente.
# Usa appsettings.Development.json para SQL Server con autenticación Windows.
# OpenAI lee OPENAI_API_KEY o OpenAI__ApiKey del entorno del proceso.
